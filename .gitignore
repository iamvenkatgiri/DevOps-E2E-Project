# Local .terraform directories
**/.terraform/*
.terraform.d/

# Terraform state files
*.tfstate
*.tfstate.*
*.tfstate.backup
*.tfstate.d/
*.tfstate.lock.info

# Terraform plan outputs
*.tfplan
*.tfplan.*

# Terraform variable files
*.tfvars
*.tfvars.json

# Terraform crash logs
crash.log
crash.*.log

# Credentials and secrets
*.json
!package.json    # Exclude package.json from being ignored
.terraformrc
terraform.rc

# Provider lock file
.terraform.lock.hcl

# macOS system files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes